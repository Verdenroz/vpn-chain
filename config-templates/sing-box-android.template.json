{
  "log": { "level": "warn" },
  "dns": {
    "servers": [
      { "type": "https", "tag": "dns-remote", "server": "1.1.1.1", "detour": "vless-proxy" }
    ],
    "final": "dns-remote",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": ["172.19.0.1/30", "fdfe:dcba:9876::1/126"],
      "mtu": 1280,
      "auto_route": true,
      "strict_route": true,
      "stack": "system"
    }
  ],
  "endpoints": [
    {
      "type": "wireguard",
      "tag": "proton-entry",
      "mtu": 1280,
      "address": ["${PROTON_ENTRY_ADDRESS}"],
      "private_key": "${PROTON_ENTRY_PRIVKEY}",
      "peers": [
        {
          "address": "${PROTON_ENTRY_HOST}",
          "port": ${PROTON_ENTRY_PORT},
          "public_key": "${PROTON_ENTRY_PEER_PUBKEY}",
          "allowed_ips": ["0.0.0.0/0"],
          "persistent_keepalive_interval": 25
        }
      ]
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "vless-proxy",
      "server": "${VPS_IP}",
      "server_port": 443,
      "uuid": "${VLESS_UUID}",
      "flow": "xtls-rprx-vision",
      "network": "tcp",
      "tls": {
        "enabled": true,
        "server_name": "${SNI}",
        "utls": { "enabled": true, "fingerprint": "chrome" },
        "reality": { "enabled": true, "public_key": "${REALITY_PUBKEY}", "short_id": "${SHORT_ID}" }
      },
      "packet_encoding": "xudp",
      "detour": "proton-entry"
    },
    { "type": "direct", "tag": "direct" }
  ],
  "route": {
    "auto_detect_interface": true,
    "final": "vless-proxy",
    "rules": [
      { "action": "sniff" },
      { "protocol": "dns", "action": "hijack-dns" }
    ]
  }
}
