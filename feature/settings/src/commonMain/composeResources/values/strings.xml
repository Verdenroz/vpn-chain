    <string name="settings_warp_domains_label">domains</string>
    <string name="settings_warp_domains_hint">The sites that refuse the relay's address, one per line. A domain covers its subdomains.</string>
    <string name="settings_kill_switch_title">kill switch</string>
    <string name="settings_dns_title">dns</string>
    <string name="settings_dns_filter_title">Block unwanted domains</string>
    <string name="settings_dns_filter_detail">Refuses known-bad domains at the chain's own resolver, so filtering still applies with no entry hop in front of it. Threats covers malware, phishing, and scams; ads adds advertising and tracker domains on top. Lists are fetched through the chain and refreshed weekly.</string>
    <string name="settings_dns_filter_off">off</string>
    <string name="settings_dns_filter_malware">threats</string>
    <string name="settings_dns_filter_ads">threats + ads</string>
    <string name="settings_fail_closed_title">Fail closed</string>
    <string name="settings_fail_closed_detail">Blocks traffic instead of leaking it if sing-box dies. Covers any tunnel this app dials itself; needs the kill-switch helper built and setcapped.</string>
