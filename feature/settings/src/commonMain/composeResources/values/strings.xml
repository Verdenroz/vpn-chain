    <string name="settings_window_title">Window</string>
    <string name="settings_close_to_tray_title">Close to tray</string>
    <string name="settings_close_to_tray_detail">Closing the window keeps the chain running and leaves the app in the system tray. Quit from the tray menu to stop it.</string>
    <string name="settings_routing_title">Routing</string>
    <string name="settings_entry_hop_title">Wireguard entry hop</string>
    <string name="settings_entry_hop_detail">Dial the relay through the profile's WireGuard hop, hiding this device's address from the relay VPS. Turn off to connect single-hop</string>
    <string name="settings_route_entire_system_title">Route entire system</string>
    <string name="settings_route_entire_system_detail">Send all system traffic through sing-box instead of a local proxy. Needs elevated privileges on the sing-box binary.</string>
    <string name="settings_warp_title">Cloudflare WARP exit</string>
    <string name="settings_warp_detail">Adds a Cloudflare hop after the relay, so sites see Cloudflare's address instead of your VPS. Fixes sites that refuse datacenter addresses outright. Cloudflare then sees which sites you reach — it still never sees this device, only the relay.</string>
    <string name="settings_warp_off">Off</string>
