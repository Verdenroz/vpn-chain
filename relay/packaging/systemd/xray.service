[Unit]
Description=Xray, the VLESS+REALITY relay
After=network-online.target vpn-chain-egress.service
Wants=network-online.target
Requires=vpn-chain-egress.service

[Service]
User=xray
Group=xray
UMask=0002
ExecStart=/opt/vpn-chain/xray/current/xray run -config /usr/local/etc/xray/config.json
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=on-failure
RestartSec=2
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
